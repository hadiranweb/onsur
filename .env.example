# Element Plus environment template.
#
# Copy to `.env.local` (Next.js) or `.env` and fill in values.
# No value here is a real secret — this file is a template only.

# Runtime environment: development | test | production
NODE_ENV=development

# PostgreSQL connection string (required since Sprint 02).
# Local development: run `pnpm db:start` to boot a local PostgreSQL (PGlite)
# and use the DATABASE_URL it prints, e.g.:
#   DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5432/postgres
DATABASE_URL=

# Session/auth signing secret (required since Sprint 02).
# Generate with: openssl rand -base64 32
AUTH_SECRET=
