# Element Plus environment template.
#
# Copy to `.env.local` (Next.js) or `.env` and fill in values.
# No value here is a real secret — this file is a template only.

# Runtime environment: development | test | production
NODE_ENV=development

# PostgreSQL connection string (required from Sprint 02 onward).
# Sprint 00/01 do not require a database.
# DATABASE_URL=postgres://user:password@localhost:5432/element_plus

# Session/auth signing secret (required from Sprint 02 onward).
# Generate with: openssl rand -base64 32
# AUTH_SECRET=
